# 统一换行符：文本文件以 LF 存储和检出（无论在哪台机器上）
* text=auto
*.gitattributes text eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.csv  text eol=lf

# 二进制文件：不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
